<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuração do IIS para o AlertaEncosta (Caminho A - site estático).
  O pool CitizenTechPool roda "Sem Código Gerenciado" (managedRuntimeVersion vazio).
-->
<configuration>
  <system.webServer>
    <!-- página inicial -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- tipos de arquivo servidos (remove antes para não duplicar se já existir no servidor) -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <!-- não listar o conteúdo das pastas -->
    <directoryBrowse enabled="false" />

    <!-- cabeçalhos de segurança (disciplina de Cybersecurity) -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="Content-Security-Policy" value="default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
